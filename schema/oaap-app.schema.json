{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaap.org/schema/oaap-app-0.1.json",
  "title": "OAAP app manifest (oaap-app.yaml), manifest version 0.1",
  "$comment": "This schema is an AUTHORING tool: it rejects unknown fields so a typo is caught where it is made. A node in the field reads more tolerantly (RFC-0012 §8.2) — it accepts a higher minor version and ignores what it does not know, because otherwise every extension of the format would be a flag day for the whole fleet. Strict schema, tolerant runtime. The newest schema always validates every manifest version still readable, so a later oaap-app-0.2.json lists both.",
  "type": "object",
  "required": ["oaap_manifest", "app", "services", "routes", "health"],
  "additionalProperties": false,
  "properties": {
    "oaap_manifest": {
      "enum": ["0.1"],
      "$comment": "MAJOR.MINOR. A new MINOR only adds; a new MAJOR is the only thing a node may refuse (RFC-0012 §8.2). Deliberately not the semver 0.x reading, where the minor would carry breaking changes."
    },
    "must_understand": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
      "$comment": "RFC-0012 §8.2 rule 2: features a reader MUST understand to handle this manifest correctly. A reader missing one refuses this app with a clear message instead of installing something half-understood — the exception that makes 'ignore what you do not know' safe. Only use it where ignoring the feature would produce a broken install; optional additions do not belong here."
    },
    "app": {
      "type": "object",
      "required": ["id", "name", "version", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
        "type": { "enum": ["native", "image", "wrapped"] },
        "description": { "type": "string" },
        "icon": { "type": "string" }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["port"],
        "additionalProperties": false,
        "properties": {
          "build": { "type": "string" },
          "image": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "subpath": { "type": "boolean" }
        },
        "oneOf": [
          { "required": ["build"] },
          { "required": ["image"] }
        ]
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "roles"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["admin", "keyuser", "user", "guest", "partner", "public"] }
          }
        }
      }
    },
    "storage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mount"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "mount": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*$" },
          "label": { "type": "string" },
          "default": { "type": "string" },
          "secret": { "type": "boolean" }
        }
      }
    },
    "health": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "startup_grace_seconds": { "type": "integer", "minimum": 0, "maximum": 1800 }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hints": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
