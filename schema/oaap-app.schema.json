{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://oaap.org/schema/oaap-app-0.1.json",
  "title": "OAAP app manifest (oaap-app.yaml), manifest version 0.1",
  "type": "object",
  "required": ["oaap_manifest", "app", "services", "routes", "health"],
  "additionalProperties": false,
  "properties": {
    "oaap_manifest": { "const": "0.1" },
    "app": {
      "type": "object",
      "required": ["id", "name", "version", "type"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 80 },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+([-+][0-9A-Za-z.-]+)?$" },
        "type": { "enum": ["native", "image", "wrapped"] },
        "description": { "type": "string" },
        "icon": { "type": "string" }
      }
    },
    "services": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["port"],
        "additionalProperties": false,
        "properties": {
          "build": { "type": "string" },
          "image": { "type": "string" },
          "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
          "subpath": { "type": "boolean" }
        },
        "oneOf": [
          { "required": ["build"] },
          { "required": ["image"] }
        ]
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "roles"],
        "additionalProperties": false,
        "properties": {
          "path": { "type": "string", "pattern": "^/" },
          "roles": {
            "type": "array",
            "minItems": 1,
            "items": { "enum": ["admin", "keyuser", "user", "guest", "partner", "public"] }
          }
        }
      }
    },
    "storage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "mount"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "mount": { "type": "string", "pattern": "^/" }
        }
      }
    },
    "config": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label"],
        "additionalProperties": false,
        "properties": {
          "key": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]*$" },
          "label": { "type": "string" },
          "default": { "type": "string" },
          "secret": { "type": "boolean" }
        }
      }
    },
    "health": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "type": "string", "pattern": "^/" },
        "startup_grace_seconds": { "type": "integer", "minimum": 0, "maximum": 1800 }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hints": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
